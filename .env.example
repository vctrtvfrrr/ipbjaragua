DATABASE_URL=postgres://user:password@host:5432/ipbjaragua
# Admin connection the migrations-table tests use to create and drop a scratch
# database. Defaults to the compose.dev Postgres service.
PG_TEST_DATABASE_URL=postgres://ipbjaragua:ipbjaragua@db:5432/postgres
MEDIA_STORAGE_PATH=/app/data
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/login/google/callback
SESSION_SECRET=change-me-to-at-least-32-random-characters
RESEND_API_KEY=
EMAIL_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Public base URL for canonical links and social (OG) image URLs. Optional: when
# unset the origin is derived from the request; set it to keep pages static.
SITE_URL=https://example.com
